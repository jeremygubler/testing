# Diese Datei nach ".env" kopieren, um die Einstellungen lokal zu ueberschreiben.
# Docker Compose liest .env automatisch -- unter Windows ist das bequemer, als
# in PowerShell Umgebungsvariablen zu setzen.

# 1 = beim ersten Start den Beispielhaushalt anlegen (2 Personen, 3 Monate Buchungen)
# 0 = leer starten, die App fuehrt durch die Einrichtung
BUDGET_SEED_DEMO=1
