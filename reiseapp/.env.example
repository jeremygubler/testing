# ---------------------------------------------------------------------------
# reiseapp – copy to .env and fill in. `docker compose` reads this file.
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Postgres / PostGIS ---
POSTGRES_USER=reiseapp
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=reiseapp
POSTGRES_PORT=5432

# --- Objektspeicher ---
# s3 = MinIO (Default). filesystem = einfaches Volume, wenn du kein MinIO willst;
# dann sind die S3_*-Werte unten irrelevant.
STORAGE_BACKEND=s3
# Maximale Foto-Grösse in Bytes (Default 64 MB – Originale sind gross)
MAX_UPLOAD_BYTES=67108864

# --- MinIO (S3-kompatibel) ---
S3_ACCESS_KEY=reiseapp-minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=reiseapp-media
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host/URL unter der die App (Handy!) MinIO erreicht – muss von aussen auflösbar
# sein, sonst laufen presigned Photo-URLs ins Leere.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Backend ---
BACKEND_PORT=8000
# runtime = schlankes Image; dev = mit Dev-Dependencies + Reload
BACKEND_TARGET=runtime
REISEAPP_ENV=production
REISEAPP_LOG_LEVEL=info
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Kommagetrennt; leer = keine Browser-Origin erlaubt (Mobile braucht kein CORS)
CORS_ORIGINS=
# false = invite-only. Ersten Account per CLI anlegen, danach Codes ausstellen:
#   docker compose exec backend python -m app.cli create-user --email .. --admin
ALLOW_REGISTRATION=false
INVITE_TTL_DAYS=14
RUN_MIGRATIONS_ON_STARTUP=true
