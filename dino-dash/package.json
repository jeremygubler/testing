{
  "name": "dino-dash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cute dino endless runner in the style of Subway Surfers",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/build-singlefile.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
